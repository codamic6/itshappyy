{
  "$schema": "https://vercel.sh",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "ai-editor": {
      "root": "ai-editor",
      "framework": "create-react-app"
    }
  },
  "rewrites": [
    {
      "source": "/editor/(.*)",
      "destination": {
        "service": "ai-editor",
        "path": "/$1"
      }
    },
    {
      "source": "/editor",
      "destination": {
        "service": "ai-editor",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
